#!name=xfbs
#!desc=xfbs
#!author=ios151[https://github.com/ios151/Rewrite]
#!category=ios151
# 由 loon2surge 从 ios151/Rewrite 同步整理

[Script]
xfbs = type=http-response, pattern=https?:\/\/xfapi\.fingerabc\.cn\/+api\/(cf\/vip\/queryList|bookModule\/get\/bookModuleAsNew|lesson\/(queryCalendarBook|queryLessons)|product\/getCategoryProduct|tagMaterial\/queryVipStatus).*, script-path=https://raw.githubusercontent.com/ios151/Rewrite/main/xfbs.js, requires-body=1, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% xfapi.fingerabc.cn
