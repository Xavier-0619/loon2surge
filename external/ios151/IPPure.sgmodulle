#!name=IPPure Panel
#!desc=显示 IPPure 欺诈分数、IP 信息以及当前节点名称。参考StashNetworks
#!author=ios151[https://github.com/ios151/Rewrite]
#!category=Information
#!system=ios
#!requirement=CORE_VERSION>=5005000
#!arguments=group:Proxy
#!arguments-desc=【可选】策略组名称。若自动嗅探失败，将读取此组选中节点。
# 由 loon2surge 从 ios151/Rewrite 同步整理

[Script]
ippure-auto = type=generic, script-path=https://gist.githubusercontent.com/Yu9191/f09695c1da79a96e65ddfeda0e41bec5/raw/ippure-ip-fraud-score.js, argument=group={{{group}}}

[Panel]
IPPure = script-name=ippure-auto, title="IPPure", content="正在检测...", icon=shield.checkerboard, update-interval=600
