#!name=麦咭TV
#!desc=麦咭TV
#!author=ios151[https://github.com/ios151/Rewrite]
#!category=ios151
# 由 loon2surge 从 ios151/Rewrite 同步整理

[URL Rewrite]
# 首页 右下角 悬浮广告
^https:\/\/api02\.maijitv\.com\/api\/v1\/layout\/floatingcards - reject
# 摇一摇弹窗屏蔽
^https:\/\/api\.maijitv\.com\/common\/findCommonConfig$ - reject

[Script]
mjtv = type=http-response, pattern=^https:\/\/api\.maijitv\.com, script-path=https://raw.githubusercontent.com/ios151/Rewrite/main/mjtv.js, requires-body=1, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.maijitv.com
