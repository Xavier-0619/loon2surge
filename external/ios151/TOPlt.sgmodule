#!name=Topluntan
#!desc=Topluntan
#!author=ios151[https://github.com/ios151/Rewrite]
#!category=ios151
# 由 loon2surge 从 ios151/Rewrite 同步整理

[Script]
Topluntan = type=http-response, pattern=^https://super\.toppps\.com/app-api/v(1|3)/(toppps/(live/getLiveSpaceDetailsV|products)|blueMain), script-path=https://raw.githubusercontent.com/ios151/Rewrite/refs/heads/main/TOPlt.js, requires-body=1, max-size=-1, timeout=60
Topluntan-Video = type=http-request, pattern=^https://mpv\.videocc\.net/.*\.mp4, script-path=https://raw.githubusercontent.com/ios151/Rewrite/refs/heads/main/TOPlt.js, timeout=60

[MITM]
hostname = %APPEND% super.toppps.com, mpv.videocc.net
