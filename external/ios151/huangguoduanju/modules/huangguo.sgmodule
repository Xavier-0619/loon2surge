#!name=黄果短剧去广告
#!desc=去广告（播放跳转/轮播/横幅/贴片）
#!author=ios151 Rewrite
#!category=18+
#!homepage=https://github.com/ios151/Rewrite
#!date=2026-09-02
# 由 loon2surge 从 ios151/Rewrite 同步整理

[Rule]
URL-REGEX,^https?://[^/]*adsdk[12]\.cc,REJECT

[Script]
黄果短剧 = type=http-response, pattern=^https?://huangguoai\.com, requires-body=1, max-size=-1, timeout=30, script-path=https://raw.githubusercontent.com/ios151/Rewrite/main/huangguoduanju/dist/huangguo.js

[MITM]
hostname = %APPEND% huangguoai.com, *.huangguoai.com, *.adsdk1.cc, *.adsdk2.cc
