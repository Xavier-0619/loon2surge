#!name=Lovekey键盘
#!desc=无限制使用 更新2026-10-11
#!author=ios151[https://github.com/ios151/Rewrite]
#!category=工具
# 由 loon2surge 从 ios151/Rewrite 同步整理

[Script]
Lovekey-聊天 = type=http-request, pattern=^https://sea\.api\.lovekeyboard\.com/\S*(?:-(?:ow|stream)-msg|stream_super_msg), requires-body=0, script-path=https://raw.githubusercontent.com/ios151/Rewrite/refs/heads/main/lovekey.js, timeout=60

Lovekey-账号 = type=http-response, pattern=^https://sea\.api\.lovekeyboard\.com/v2/account, requires-body=1, script-path=https://raw.githubusercontent.com/ios151/Rewrite/refs/heads/main/lovekey.js, timeout=60

[MITM]
hostname = %APPEND% sea.api.lovekeyboard.com
