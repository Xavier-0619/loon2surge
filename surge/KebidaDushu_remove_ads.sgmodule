(?i:^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/chief-orch\/config\/config\/v\d+\/appConfig) data-type=text data="" status-code=404
(?i:^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/order-orchestration\/orderWeb\/exchange\/v100\/showExchangeButton) data-type=text data="" status-code=404

[MITM]
hostname = %APPEND% g*.dushu365.com

