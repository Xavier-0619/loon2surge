#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=6008000

# 由 loon2surge 自动转换

[Rule]
DOMAIN,ad.jia.360.cn,REJECT,extended-matching,pre-matching
DOMAIN,ad.iot.360.cn,REJECT,extended-matching,pre-matching

[Body Rewrite]
http-response-jq (?i:^https:\/\/jia\.360\.cn\/conf\/v1\.json) 'delpaths([["tab_conf"],["ad_conf"],["activity"]])'

[MITM]
hostname = %APPEND% jia.360.cn
