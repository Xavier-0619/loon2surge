#!requirement=CORE_VERSION>=20

# 由 loon2surge 自动转换
# 有 2 行无法自动转换，见文件末尾注释

[Map Local]
(?i:^https:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=advis) data-type=text data="" status-code=404
(?i:^https:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=vip_coupon) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/ptf\.flyertrip\.com\/static\/img\/common\/ic_plate_mine_button\.png) data-type=tiny-gif status-code=200
(?i:^https:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=getdata) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% www.flyert.com.cn, ptf.flyertrip.com

# ---- 以下 Loon 原始行无法自动转换，请人工确认 ----
