#!requirement=CORE_VERSION>=6008000

# 由 loon2surge 自动转换

[Body Rewrite]
http-response-jq (?i:^https:\/\/api\.romielf\.com\/index\/indexv\d\?) 'try setpath(["data.advertisement\", \"data.listadvertising"]; ["[]", "[]"]) catch .'
http-response-jq (?i:^https:\/\/api\.romielf\.com\/index\/indexv\d\?) '.data.list |= map(select(.type == 1))'

[MITM]
hostname = %APPEND% api.romielf.com
