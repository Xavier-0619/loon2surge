#!name=面具公社
#!desc=18+
#!author=ios151[https://github.com/ios151/Rewrite]
#!category=ios151
# 由 loon2surge 从 ios151/Rewrite 同步整理

[URL Rewrite]
#游戏
^https:\/\/(mfjk|gnjk|buyaoda).+\.com\/request_game\/v3\/game\/list - reject-dict

[Script]
#广告
mjgsad = type=http-response, pattern=https:\/\/(mfjk|gnjk|buyaoda).+\.com\/(playerinfo|api\/home\/popup|api\/get_advert), script-path=https://raw.githubusercontent.com/ios151/Rewrite/main/lsp/mjgsad.js, requires-body=1, max-size=-1, timeout=60

#视频
mjgshd = type=http-request, pattern=https?:\/\/(mfjk|gnjk|buyaoda).+\.com\/api\/(comic|video|short_movie_info|novel|gallery|vip|index), script-path=https://raw.githubusercontent.com/ios151/Rewrite/main/lsp/mjgshd.js, timeout=60

[MITM]
hostname = %APPEND% gnjk.*.com, mfjk.*.com, buyaoda.*.com
