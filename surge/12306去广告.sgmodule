# 由 loon2surge 自动转换
# 有 1 行无法自动转换，见文件末尾注释

[Rule]
DOMAIN,ad.12306.cn,DIRECT,extended-matching

[Body Rewrite]
http-response-jq (?i:^https:\/\/ad\.12306\.cn\/ad\/ser\/getAdList$) 'delpaths([["materialsList"],["advertParam"]])'

[MITM]
hostname = %APPEND% ad.12306.cn, mobile.12306.cn

