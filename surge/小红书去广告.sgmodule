#!name=小红书去广告
#!desc=过滤信息流推广，移除图片及视频水印，如有异常，请先清除缓存再尝试。
#!author=RuCu6[https://github.com/RuCu6], fmz200[https://github.com/fmz200]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/RedPaper.png
#!category=可莉插件
#!openUrl=https://apps.apple.com/app/id741292507
#!tag=去广告
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=6008000

# 由 loon2surge 自动转换

[Rule]
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,xiaohongshu.com,extended-matching)),REJECT,pre-matching

[Body Rewrite]
http-response-jq (?i:^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/search\/banner_list$) 'try setpath(["data"]; {}) catch .'
http-response-jq (?i:^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/search\/hot_list$) 'try setpath(["data","items"]; []) catch .'
http-response-jq (?i:^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/search\/hint) 'try setpath(["data","hint_words"]; []) catch .'
http-response-jq (?i:^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/search\/trending\?) 'try setpath(["data.queries\", \"data.hint_word"]; ["[]", "{}"]) catch .'

[Map Local]
(?i:^https:\/\/ci\.xiaohongshu\.com\/system_config\/watermark) data-type=tiny-gif status-code=200
(?i:^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/surprisebox\/(?:get_style|open|submit_action)) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/www\.xiaohongshu\.com\/api\/marketing\/box\/trigger\?) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(?:v2\/guide\/user_banner|v3\/note\/guide)) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/www\.xiaohongshu\.com\/api\/sns\/(?:v1\/ads\/resource|v2\/hey\/\w+\/hey_gallery)) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
移除图片和实况照片水印 = type=http-response, pattern=(?i:^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/note\/(?:imagefeed|live_photo\/save)), script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true, timeout=10
移除整体配置 ui = type=http-response, pattern=(?i:^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/system\/service\/ui\/config\?), script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true, timeout=10
移除开屏广告 config = type=http-response, pattern=(?i:^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/system_service\/config\?), script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true, timeout=10
移除开屏广告 splash_config = type=http-response, pattern=(?i:^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v2\/system_service\/splash_config), script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true, timeout=10
移除详情页小部件、关注页感兴趣的人 = type=http-response, pattern=(?i:^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v2\/(?:note\/widgets|user\/followings\/followfeed)), script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true, timeout=10
移除信息流广告 = type=http-response, pattern=(?i:^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/followfeed\?), script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true, timeout=10
移除详情页感兴趣的人 = type=http-response, pattern=(?i:^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v5\/recommend\/user\/follow_recommend\?), script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true, timeout=10
移除评论区实况照片水印 = type=http-response, pattern=(?i:^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(?:v1\/interaction\/comment\/video\/download|v5\/note\/comment\/list)), script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true, timeout=10
移除图片和视频水印 = type=http-response, pattern=(?i:^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(?:v2\/note\/feed|v3\/note\/videofeed)), script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true, timeout=10
移除信息流广告-2 = type=http-response, pattern=(?i:^https:\/\/(?:edith|rec)\.xiaohongshu\.com\/api\/sns\/v6\/homefeed\?), script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true, timeout=10
移除搜索页广告 = type=http-response, pattern=(?i:^https:\/\/(?:edith|so)\.xiaohongshu\.com\/api\/sns\/v10\/search\/notes\?), script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true, timeout=10
移除视频水印 = type=http-response, pattern=(?i:^https:\/\/(?:edith|rec|www)\.xiaohongshu\.com\/api\/sns\/(?:v4\/note\/videofeed|v10\/note\/video\/save)), script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true, timeout=10

[MITM]
hostname = %APPEND% ci.xiaohongshu.com, edith.xiaohongshu.com, rec.xiaohongshu.com, so.xiaohongshu.com, www.xiaohongshu.com
