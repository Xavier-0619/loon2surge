[Map Local]
(?i:^https:\/\/j1\.pupuapi\.com\/client\/account\/discount\/order) data-type=text data="" status-code=404
(?i:^https:\/\/j1\.pupuapi\.com\/client\/marketing\/banner\/v7\?position_types=100) data-type=text data="" status-code=404

[MITM]
hostname = %APPEND% j1.pupuapi.com

