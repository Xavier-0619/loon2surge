# 由 loon2surge 自动转换

[Script]
移除开屏广告 = type=http-response, pattern=(?i:^https:\/\/jzts\.cmpassport\.com\/personalized\/getPushContent), script-path=https://kelee.one/Resource/JavaScript/mobileClouds/mobileClouds_remove_ads.js, requires-body=true, timeout=10
移除应用内广告 = type=http-response, pattern=(?i:^https:\/\/ad\.mcloud\.139\.com\/advertapi\/adv-filter\/), script-path=https://kelee.one/Resource/JavaScript/mobileClouds/mobileClouds_remove_ads.js, requires-body=true, timeout=10

[MITM]
hostname = %APPEND% jzts.cmpassport.com, ad.mcloud.139.com
