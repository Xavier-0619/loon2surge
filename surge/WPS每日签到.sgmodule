[Script]
{{{CaptureCookie}}}捕获Cookie = type=http-request, pattern=(?i:^https:\/\/moapi\.wps\.cn\/app\/ios\/v1\/app$), script-path=https://kelee.one/Resource/JavaScript/WPS/WPS_checkin.js, requires-body=true, timeout=10
WPS每日签到 = type=cron, cronexp="{{{CRONEXP}}}", script-path=https://kelee.one/Resource/JavaScript/WPS/WPS_checkin.js, timeout=120, argument="{\"AK\":{{{AK}}},\"SK\":{{{SK}}},\"MAX_RETRIES\":{{{MAX_RETRIES}}}}"

[MITM]
hostname = %APPEND% moapi.wps.cn
