#!name=脉脉去广告
#!desc=移除开屏广告、信息流广告、横幅推广、相关帖子推荐。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/MaiMai.png
#!category=可莉插件
#!openUrl=https://apps.apple.com/app/id718659370
#!tag=去广告
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=6008000

# 由 loon2surge 自动转换
# 有 1 行无法自动转换，见文件末尾注释

[Body Rewrite]
http-response-jq (?i:^https:\/\/(h3\.)?open\.taou\.com\/maimai\/feed\/v6\/detail_recommend_feeds\?) 'delpaths([["feeds"]])'

[Map Local]
(?i:^https:\/\/(h3\.)?open\.taou\.com\/maimai\/adshow\?) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/(h3\.)?open\.taou\.com\/maimai\/pay\/v5\/check_gift\?) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/(h3\.)?open\.taou\.com\/maimai\/go_gossip_darwin\/external\/v2\/query_flow_cards\?) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% open.taou.com, h3.open.taou.com

# ---- 以下 Loon 原始行无法自动转换，请人工确认 ----
# response if ${url} ~= /^https:\/\/(h3\.)?open\.taou\.com\/maimai\/(feed|gossip)\/v\d\/(focus_feed|gossip_detail_comment|feed_detail_comment?)\?/i then script("https://kelee.one/Resource/JavaScript/MaiMai/MaiMai_remove_ads.js") with tag="移除信息流和评论区大块广告", requires_body=true
