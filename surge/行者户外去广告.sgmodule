[Body Rewrite]
http-response-jq (?i:^https:\/\/www\.imxingzhe\.com\/api\/v4\/account\/get_user_info\?) 'delpaths([["banner"]])'
http-response-jq (?i:^https:\/\/www\.imxingzhe\.com\/api\/v4\/discovery\/ios\/\?) 'delpaths([["banners"],["ad"]])'
http-response-jq (?i:^https:\/\/www\.imxingzhe\.com\/api\/v4\/discovery\/ios\/\?) '.display_areas |= map(select(.name == "赛事" or .name == "行�\u0085帮" or .name == "头条" or .name == "排行榜" or .name == "约伴"))'

[Map Local]
(?i:^https:\/\/www\.imxingzhe\.com\/api\/v1\/pop\/window\/\?) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% www.imxingzhe.com
