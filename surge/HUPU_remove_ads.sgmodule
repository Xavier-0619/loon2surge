#!requirement=CORE_VERSION>=20

# 由 loon2surge 自动转换
# 有 4 行无法自动转换，见文件末尾注释

[Map Local]
(?i:^https:\/\/games\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/bplapi\/reddot\/v1\/app\/getReddot) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/bbs\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/(bbsallapi\/tag\/v1\/heatTag|bbsrankapi\/v1\/rating\/list)) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/games\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/search\/v2\/(hintkeylist|hotkeylist)) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/goblin\.hupu\.com\/\d\/\d\.\d\.\d+\/interfaceAd\/getOther\/v\d) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/goblin\.hupu\.com\/\d\/\d\.\d\.\d+\/interfaceAd\/getOther\/batch) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/fairy\.mobileapi\.hupu\.com\/gallery\/getmod2) data-type=text data="" status-code=200
(?i:^https:\/\/games\.mobileapi\.hupu\.com\/3\/8\.0\.86\/bplcommentapi\/bpl\/score_tab\/groups) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/games\.mobileapi\.hupu\.com\/3\/8\.0\.86\/bplapi\/banner\/getLocationBanners) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% games.mobileapi.hupu.com, fairy.mobileapi.hupu.com, bbs.mobileapi.hupu.com, goblin.hupu.com

