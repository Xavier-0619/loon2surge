#!name=Yu9191 → ios151 链接重定向
#!desc=旧号 Yu9191 已迁移至 ios151，访问 raw / github 旧路径时自动 302 到新号
#!author=ios151
#!category=ios151
#!homepage=https://github.com/ios151/Rewrite
# 由 loon2surge 从 ios151/Rewrite 同步整理

[URL Rewrite]
^https:\/\/raw\.githubusercontent\.com\/Yu9191\/Yu9191\/(.*) https://raw.githubusercontent.com/ios151/ios151/$1 302
^https:\/\/raw\.githubusercontent\.com\/Yu9191\/(.*) https://raw.githubusercontent.com/ios151/$1 302
^https:\/\/github\.com\/Yu9191\/Yu9191(\/.*)?$ https://github.com/ios151/ios151$1 302
^https:\/\/github\.com\/Yu9191(\/.*)?$ https://github.com/ios151$1 302

[MITM]
hostname = %APPEND% raw.githubusercontent.com, github.com
