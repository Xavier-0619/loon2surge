[Body Rewrite]
http-response-jq (?i:^https:\/\/bd-api\.kuwo\.cn\/api\/service\/conf\/all\?) 'delpaths([["data","groupSign","adStartAppDialog"],["data","groupSign","adGuideTest"],["data","groupSign","playTips"],["data","groupSign","adExitChange"],["data","conf","adGuidePopCount"],["data","conf","adDownListOpen"]])'
http-response-jq (?i:^https:\/\/bd-api\.kuwo\.cn\/api\/service\/conf\/all\?) 'try setpath(["data.conf.flowControlConfig.uploadEnable\", \"data.conf.flowControlConfig.p2pEnable"]; [false, false]) catch .'
http-response-jq (?i:^https:\/\/ab-bodian\.kuwo\.cn\/abtest\/ui\/info\?) 'delpaths([["data","mapTestInfo","CommentADPosition"],["data","mapTestInfo","DiscoverADPosition"],["data","mapTestInfo","DownloadAd"],["data","mapTestInfo","FreeModVoiceReminder"],["data","mapTestInfo","GamesTrans"],["data","mapTestInfo","bodianmvdialog"],["data","mapTestInfo","MvTryShowAds"],["data","mapTestInfo","insert"]])'
http-response-jq (?i:^https:\/\/bd-api\.kuwo\.cn\/api\/service\/global\/config\/scene\?) 'delpaths([["data","iosP2PCacheEnable"],["data","warmStartDialog"],["data","adsNotFinishVipPop4DayInterval"]])'
http-response-jq (?i:^https:\/\/bd-api\.kuwo\.cn\/api\/service\/global\/config\/scene\?) 'try setpath(["data.showShopEntry\", \"data.iosP2pEnableSendDataLimit"]; [false, 1]) catch .'
http-response-jq (?i:^https:\/\/bd-api\.kuwo\.cn\/api\/search\/topic\/word\/list\?) 'delpaths([["data","hotTopic"],["data","searchFind"],["data","globalJumpInfo"],["data","hotWord"]])'
http-response-jq (?i:^https:\/\/bd-api\.kuwo\.cn\/api\/service\/home\/index\?) '.data.moduleList |= map(select(.type | tostring | (. != \"8\" and . != \"1\")))'
http-response-jq (?i:^https:\/\/bd-api\.kuwo\.cn\/api\/service\/music\/recommendList\?) '.data.musicList[] |= del(.showAd)'
http-response-jq (?i:^https:\/\/bd-api\.kuwo\.cn\/api\/comments\/v3\/topInfo\?) 'delpaths([["data","putao"],["data","bannerVos"]])'

