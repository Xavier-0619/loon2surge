# 由 loon2surge 自动转换

[Body Rewrite]
http-response-jq (?i:^https:\/\/helper\.2bulu\.com\/getAppEntranceConfig\?) '.configData=(.configData|fromjson|del(.adPlatform,.adIntertitialShowType,.adsConfig,.adIntertitialDisplayedLimit,.adSplashShowTypeWhenHotStart,.adIntertitialDayDisplayedMaxCount,.od_adsType,.showMeBaiHeAdView)|tojson)'

[Map Local]
(?i:^https:\/\/helper\.2bulu\.com\/search\/searchHotKeyList\?) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/helper\.2bulu\.com\/promote\/getAppUserModule\?) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/helper\.2bulu\.com\/proSpecial\/allData\?) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% helper.2bulu.com
