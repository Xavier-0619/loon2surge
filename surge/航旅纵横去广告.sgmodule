[Rule]
URL-REGEX,"^http?:\/\/(discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native",REJECT,extended-matching,pre-matching

[Script]
移除首页广告 = type=http-response, pattern=(?i:^http?:\/\/(114\.115\.217\.129)|(home\.umetrip\.com)\/gateway\/api\/umetrip\/native$), script-path=https://kelee.one/Resource/JavaScript/Umetrip/Umetrip_remove_ads.js, timeout=10

[MITM]
hostname = %APPEND% 114.115.217.129, home.umetrip.com
