#!name=Script-Hub
#!desc=将其他工具的Rewrite、Rule和JavaScript资源转换为Loon能识别的格式，使用前请在本插件的详情页面为[PROXY]项分配代理策略。在插件列表中点击此插件上的链接查看使用方法。
#!author=xream[https://github.com/xream], Keywos[https://github.com/Keywos], CKYB[https://github.com/CKYB], 小白脸
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/Other_icon/120px/Script-Hub.png
#!category=可莉插件
#!openUrl=https://script.hub/
#!tag=资源转换
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=20

# 由 loon2surge 自动转换
# 有 1 行无法自动转换，见文件末尾注释

[Script]
前端界面 = type=http-request, pattern=(?i:^https?:\/\/script\.hub\/($|edit\/|reload)), script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/script-hub.js, timeout=300
Rewrite转换 = type=http-request, pattern=(?i:^https?:\/\/script\.hub\/file\/_start_\/.+type=(?:qx-rewrite|surge-module|loon-plugin|all-module)), script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/Rewrite-Parser.js, timeout=300
Rule转换 = type=http-request, pattern=(?i:^https?:\/\/script\.hub\/file\/_start_\/.+type=rule-set), script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/rule-parser.js, timeout=300
JavaScript转换 = type=http-request, pattern=(?i:^https?:\/\/script\.hub\/convert\/), script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/script-converter.js, timeout=300

[MITM]
hostname = %APPEND% script.hub, *.script.hub

# ---- 以下 Loon 原始行无法自动转换，请人工确认 ----
# DOMAIN, scripthub.vercel.app, PROXY
