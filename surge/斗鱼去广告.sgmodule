#!name=斗鱼去广告
#!desc=移除开屏、首页视频流、首页轮播图广告，移除直播间悬浮窗。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Douyu.png
#!category=可莉插件
#!openUrl=https://apps.apple.com/app/id863882795
#!tag=去广告
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=6008000

# 由 loon2surge 自动转换
# 有 1 行无法自动转换，见文件末尾注释

[Rule]
URL-REGEX,"^http:\/\/linkmicschedule\.douyucdn\.cn\/im_schedule\/im_gate_list",REJECT,extended-matching,pre-matching
AND,((DEST-PORT,18000),(PROTOCOL,STUN)),REJECT,pre-matching
DOMAIN,stun1.douyucdn.cn,REJECT,extended-matching,pre-matching
DOMAIN,stun1.qvb.qcloud.com,REJECT,extended-matching,pre-matching
DOMAIN,^(http:\/\/)((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\/(hlsh5p1\.douyucdn2\.cn)(.*) 307 $1$5$6,REJECT,extended-matching,pre-matching

[Body Rewrite]
http-response-jq (?i:^https:\/\/apiv2\.douyucdn\.cn\/japi\/entrance\/roomRes\/nc\/m\/list) 'delpaths([["data","pendant_a"],["data","entrance_d"]])'
http-response-jq (?i:^https:\/\/venus\.douyucdn\.cn\/venus\/config\/static\/update.+keyCodeSet=flow_config) 'try setpath(["greatGodGameSitterSwitch\", \"followMoreAnchorEntrance\", \"sdklivebanner\", \"homeActFloatSwitch\", \"bringGoodsSwitch\", \"qqGameSwitch"]; [0, 0, 0, 0, 0, 0]) catch .'

[Map Local]
(?i:^https:\/\/rtbapi\.douyucdn\.cn\/japi\/sign\/app\/getinfo) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% rtbapi.douyucdn.cn, apiv2.douyucdn.cn, venus.douyucdn.cn

# ---- 以下 Loon 原始行无法自动转换，请人工确认 ----
# response if ${url} ~= /^https:\/\/apiv2\.douyucdn\.cn\/mgapi\/livenc\/home\/getRecV3/i then script("https://kelee.one/Resource/JavaScript/Douyu/Douyu_remove_ads.js") with tag="移除首页轮播图和视频流广告", requires_body=true
