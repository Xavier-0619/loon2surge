# 由 loon2surge 自动转换

[Body Rewrite]
http-response-jq (?i:^https?:\/\/p\.kuaidi100\.com\/mobile\/mobileapi\.do$) 'delpaths([["adsplash"],["adIsConsumable"],["adProductId"],["nologin_tips"],["index_banner"],["me_banner"],["index_banner_shadow"],["adshongbao"],["adsapp_homepage_ticket_pop"],["adsoptimizationsend"],["adsapp_activity_ad_array"],["adbanner"],["adposition"],["adShowAgainTime"]])'
http-response-jq (?i:^https?:\/\/p\.kuaidi100\.com\/apicenter\/xcx\.dox) 'delpaths([["data","secondMenuList"]])'

[Map Local]
(?i:^https?:\/\/p\.kuaidi100\.com\/advertisement\/) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https?:\/\/p\.kuaidi100\.com\/e-commerce\/act\/actInfo\?) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https?:\/\/p\.kuaidi100\.com\/apicenter\/card\.dox) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% p.kuaidi100.com
