[Map Local]
(?i:^https:\/\/api\.fzxhmy\.com\/seek\/trendingword\?) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/api\.fzxhmy\.com\/tone\/trending\?) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api.fzxhmy.com

