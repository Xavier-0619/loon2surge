# 由 loon2surge 自动转换

[Map Local]
(?i:^https:\/\/api\.fzxhmy\.com\/seek\/trendingword\?) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/api\.fzxhmy\.com\/tone\/trending\?) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
移除首页广告配置 = type=http-response, pattern=(?i:^https:\/\/api\.fzxhmy\.com\/core\/initialize\?), script-path=https://kelee.one/Resource/JavaScript/iWallBiZhi/core_initialize.js, requires-body=true, timeout=10
移除首页轮播图广告 = type=http-response, pattern=(?i:^https:\/\/api\.fzxhmy\.com\/landing\/initialize\?), script-path=https://kelee.one/Resource/JavaScript/iWallBiZhi/landing_initialize.js, requires-body=true, timeout=10
移除头像页横幅跳转 = type=http-response, pattern=(?i:^https:\/\/api\.fzxhmy\.com\/avatar\/landing\?), script-path=https://kelee.one/Resource/JavaScript/iWallBiZhi/landing.js, requires-body=true, timeout=10

[MITM]
hostname = %APPEND% api.fzxhmy.com
