#!name=妻社 VIP解锁
#!desc=解锁VIP视频/帖子、去广告弹窗、用户组提权
#!author=ios151
#!category=18+
#!homepage=https://github.com/ios151/Rewrite
# 由 loon2surge 从 ios151/Rewrite 同步整理

[Script]
妻社 = type=http-response,pattern=^https?:\/\/[\w-]+\.qsh\d+\.(?:com|cn|org\.cn)\/(?:source\/plugin\/qsts_app\/index\.php|mserver)\/,requires-body=1,max-size=-1,timeout=30,script-path=https://raw.githubusercontent.com/ios151/Rewrite/refs/heads/main/qishe/qishe.js

[MITM]
hostname = %APPEND% *.qsh526215.org.cn, *.qsh526724.com
