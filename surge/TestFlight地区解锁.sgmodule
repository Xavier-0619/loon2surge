[Body Rewrite]
http-request-replace-regex (?i:^https?:\/\/testflight\.apple\.com\/v\d\/accounts\/.+?\/install$) '"storefrontId"\x20:\x20"\d{6}-\d{2},\d{2}",' '\"storefrontId\":\"143441-19,29\",'

[MITM]
hostname = %APPEND% testflight.apple.com

