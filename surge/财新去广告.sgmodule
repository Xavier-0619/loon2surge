#!tag=去广告
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=5006000

# 由 loon2surge 自动转换

[Map Local]
(?i:^https:\/\/entities\.caixin\.com\/api\/(dataplus\/promotionHints|public\/push\/appIndex|public\/recommendNews)) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/gateway\.caixin\.com\/api\/app-api\/cxAdInfo\/selectIndexAdInfo) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/mappsv5\.caixin\.com\/channelv5\/article_ad_ios_info\.json) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/gg\.caixin\.com\/s\?z=caixin&slot=\d+) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/msgapi\.caixin\.com\/msg_api\/annmsg\/annlist) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
移除财新数据通广告 = type=http-response, pattern=(?i:^https:\/\/entities\.caixin\.com\/api\/dataplus\/columns), script-path=https://kelee.one/Resource/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js, requires-body=true, timeout=10
移除文末广告 = type=http-response, pattern=(?i:^https:\/\/gateway\.caixin\.com\/api\/app-api\/(caixinapp\/appinfo|search\/getkeyword)), script-path=https://kelee.one/Resource/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js, requires-body=true, timeout=10
移除财新FM广告 = type=http-response, pattern=(?i:^https:\/\/gateway\.caixin\.com\/api\/app-content\/fm\/index\/list\?), script-path=https://kelee.one/Resource/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js, requires-body=true, timeout=10
移除开屏广告 = type=http-response, pattern=(?i:^https:\/\/gg\.caixin\.com\/s\?z=caixin&op=\d), script-path=https://kelee.one/Resource/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js, requires-body=true, timeout=10
移除正文广告 = type=http-response, pattern=(?i:^https:\/\/mappsv5\.caixin\.com\/articlev5\/\d+\/\d+\.json$), script-path=https://kelee.one/Resource/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js, requires-body=true, timeout=10
移除正文广告-2 = type=http-response, pattern=(?i:^https:\/\/mapps?v5\.caixin\.com\/(channelv5\/list|\/?index_page_v5\/)\w+), script-path=https://kelee.one/Resource/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js, requires-body=true, timeout=10

[MITM]
hostname = %APPEND% e*.caixin.com, g*.caixin.com, m*.caixin.com
