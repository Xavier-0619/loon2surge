#!name=IPA工具箱助手
#!desc=这是IPA工具箱的辅助插件，用于下载IPA包和应用降级。IPA工具箱是运行在Scripting应用中的脚本，需要购买Scripting的Pro版本才能运行。
#!author=小白脸
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/Other_icon/120px/IPATool.png
#!category=可莉插件
#!openUrl=https://apps.apple.com/app/id6479691128
#!tag=功能增强
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=20

# 由 loon2surge 自动转换

[Script]
App Store API = type=http-request, pattern=(?i:^https:\/\/apple-api\.com), script-path=https://kelee.one/Resource/JavaScript/IPATool/AppStoreAPI.js, requires-body=true, timeout=10
安装器 = type=http-request, pattern=(?i:^https:\/\/xiaobai\.app), script-path=https://kelee.one/Resource/JavaScript/IPATool/Installer.js, timeout=10

[MITM]
hostname = %APPEND% apple-api.com, xiaobai.app
