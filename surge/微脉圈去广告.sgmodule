# 由 loon2surge 自动转换

[Body Rewrite]
http-response-jq (?i:^https:\/\/confssl\d?\.iweimai\.cn\/wm_ios_update\.json\?) 'try setpath(["isShowCJAd"]; 0) catch .'
http-response-jq (?i:^https:\/\/confssl\d?\.iweimai\.cn\/wm_ios_update\.json\?) 'delpaths([["launchAd"],["adBanners"],["ad"]])'

[MITM]
hostname = %APPEND% confssl*.iweimai.cn
