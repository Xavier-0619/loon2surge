#!name=转转去广告
#!desc=移除开屏广告、应用内悬浮窗、信息流推广、商品推荐、首页弹窗，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ZhuanZhuan.png
#!category=可莉插件
#!openUrl=https://apps.apple.com/app/id1002355194
#!tag=去广告
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=6008000

# 由 loon2surge 自动转换
# 有 3 行无法自动转换，见文件末尾注释

[Body Rewrite]
http-response-jq (?i:^https:\/\/app\.zhuanzhuan\.com\/zz\/v2\/zzlogic\/mycontinenthomepage\?) 'delpaths([["respData","topOpera","leftOpera"],["respData","topOpera","rightOpera2"],["respData","topActBanner"],["respData","bmArea"]])'
http-response-jq (?i:^https:\/\/app\.zhuanzhuan\.com\/zzx\/transfer\/getConfigInfo\?) 'delpaths([["respData","freeMarketTabLeadPop"],["respData","topOperations"]])'
http-response-jq (?i:^https:\/\/app\.zhuanzhuan\.com\/zz\/v2\/zzinfoshow\/getfeedflowinfo\?) 'if .respData.userRed.campName == \"OCD挂件\" then del(.respData.userRed) else . end | .respData.infoData |= map(del(.rotateResource,.appRecommendResource,.\"cargoGroupCardV2\"))'
http-response-jq (?i:^https:\/\/app\.zhuanzhuan\.com\/zz\/transfer\/getmymoretools$) 'walk(if type == \"object\" and .name == \"免流量特权\" then empty else . end) | del(.respData.groupList[] | select(.groupName == \"活动参与\" or .groupName == \"金融工具\"))'
http-response-jq (?i:^https:\/\/app\.zhuanzhuan\.com\/zz\/transfer\/getmyprofilev3$) 'delpaths([["respData","bmNewInfo"]])'
http-response-jq (?i:^https:\/\/app\.zhuanzhuan\.com\/zz\/transfer\/getmyprofilev3$) 'del(.respData.itemGroupList[].itemList[] | select(.name == \"天天赚钱\" or .name == \"借钱\")) | del(.respData.itemGroupList[] | select(.groupType == 15))'

[Map Local]
(?i:^https:\/\/app\.zhuanzhuan\.com\/zz\/v2\/zzlogic\/getOpenScreen$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/app\.zhuanzhuan\.com\/zz\/v2\/zzinfoshow\/getwindvanecardv2$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/app\.zhuanzhuan\.com\/zzopen\/popwindow\/getallpopwin\?) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/app\.zhuanzhuan\.com\/zzopen\/zzbmlogic\/queryFrontPageWindowInfo\?) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/app\.zhuanzhuan\.com\/zzopen\/ptuserlogic\/subscribehotrecommend$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/app\.zhuanzhuan\.com\/zzopen\/ypmall\/listData$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/app\.zhuanzhuan\.com\/zz\/v2\/zzusercenter\/myprofilevariouscards$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% app.zhuanzhuan.com

