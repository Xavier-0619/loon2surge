# 由 loon2surge 自动转换

[Body Rewrite]
http-response-jq (?i:^https:\/\/api\.zsxq\.com\/v2\/groups\/\d+$) 'try setpath(["resp_data","group","policies","enable_watermark"]; false) catch .'
http-response-replace-regex (?i:^https:\/\/articles\.zsxq\.com\/inline_form\/id_[a-z0-9]+\.html) 'name="group_enable_watermark"\x20value="true"' 'name=\"group_enable_watermark\" value=\"false\"'

[MITM]
hostname = %APPEND% api.zsxq.com
